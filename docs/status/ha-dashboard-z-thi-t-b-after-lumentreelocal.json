                "row_production": "[[[ const s = states['sensor.lumentree_local_p240819130_daily_pv_energy']; const state = s ? s.state : '—'; const unit = s?.attributes?.unit_of_measurement || 'kWh'; return `\n      <div style=\"display:flex;align-items:center;justify-content:space-between;padding:16px 16px;border-radius:20px;background:linear-gradient(135deg, rgba(var(--rgb-primary-color),0.16) 0%, rgba(var(--rgb-primary-color),0.08) 100%);border:1px solid rgba(var(--rgb-primary-color),0.18);box-shadow:0 10px 24px rgba(15,23,42,0.08);\">\n        <div style=\"display:flex;align-items:center;gap:12px;\">\n          <div style=\"width:44px;height:44px;border-radius:16px;background:rgba(var(--rgb-primary-color),0.14);display:flex;align-items:center;justify-content:center;\">\n            <ha-icon icon=\"mdi:solar-power-variant\" style=\"color:var(--primary-color);width:24px;height:24px;\"></ha-icon>\n          </div>\n          <div>\n            <div style=\"font-size:0.8rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--secondary-text-color);\">Live production</div>\n            <div style=\"font-size:1.02rem;color:var(--primary-text-color);font-weight:800;\">Energy generated today</div>\n          </div>\n        </div>\n        <div style=\"font-size:1.34rem;font-weight:900;color:var(--primary-color);\">${state} <span style=\"font-size:0.8rem;opacity:0.8;\">${unit}</span></div>\n      </div>`; ]]]",
