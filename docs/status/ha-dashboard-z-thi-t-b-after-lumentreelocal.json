              "custom_fields": {
                "soc": "[[[ const soc = parseFloat(states['sensor.lumentree_local_p240819130_battery_soc']?.state || 0); return `${soc.toFixed(0)}%`; ]]]",
                "power": "[[[ const p = parseFloat(states['sensor.lumentree_local_p240819130_battery_power']?.state || 0); const status = (states['sensor.lumentree_local_p240819130_battery_status']?.state || '').toLowerCase(); const prefix = status.includes('charg') ? 'Charge' : status.includes('discharg') ? 'Discharge' : Math.abs(p) < 1 ? 'Idle' : 'Battery'; return `${prefix} ${Math.abs(p).toFixed(0)} W`; ]]]",
                "top_left": "[[[ const soc = parseFloat(states['sensor.lumentree_local_p240819130_battery_soc']?.state || 0); const remaining = (14 * soc / 100).toFixed(1); const p = parseFloat(states['sensor.lumentree_local_p240819130_battery_power']?.state || 0); const status = (states['sensor.lumentree_local_p240819130_battery_status']?.state || '').toLowerCase(); const abs = Math.abs(p); let label = 'Standby'; let time = '—'; if (abs >= 10) { if (status.includes('discharg')) { label = 'Empty in'; const hours = (14 * (soc / 100)) / (abs / 1000); if (isFinite(hours)) { const h = Math.floor(hours); const m = Math.round((hours - h) * 60); time = `${h}h ${m}m`; } } else if (status.includes('charg')) { label = 'Full in'; const hours = (14 * (1 - soc / 100)) / (abs / 1000); if (isFinite(hours)) { const h = Math.floor(hours); const m = Math.round((hours - h) * 60); time = `${h}h ${m}m`; } } } return `<div style=\"font-size:0.76rem;color:var(--secondary-text-color);font-weight:700;letter-spacing:0.08em;text-transform:uppercase;\">Battery</div><div style=\"font-size:0.95rem;color:var(--primary-text-color);font-weight:800;margin-top:2px;\">${remaining} / 14 kWh</div><div style=\"font-size:0.78rem;color:var(--secondary-text-color);margin-top:8px;\">${label}</div><div style=\"font-size:1rem;color:var(--primary-color);font-weight:800;\">${time}</div>`; ]]]",
                "top_right": "[[[ const charge = parseFloat(states['sensor.lumentree_local_p240819130_daily_battery_charge_energy']?.state || 0); const discharge = parseFloat(states['sensor.lumentree_local_p240819130_daily_battery_discharge_energy']?.state || 0); return `<div style=\"font-size:0.76rem;color:var(--secondary-text-color);font-weight:700;letter-spacing:0.08em;text-transform:uppercase;\">Today</div><div style=\"font-size:0.92rem;color:#16a34a;font-weight:800;margin-top:4px;\">Charge ${charge.toFixed(1)} kWh</div><div style=\"font-size:0.92rem;color:#ea580c;font-weight:800;margin-top:4px;\">Discharge ${discharge.toFixed(1)} kWh</div>`; ]]]",
                "bottom_right": "[[[ const load = states['sensor.lumentree_local_billing_cycle_load_energy']?.state ?? '—'; const cost = parseFloat(states['sensor.lumentree_local_billing_cycle_equivalent_bill']?.state); const costStr = isNaN(cost) ? 'N/A' : `${cost.toLocaleString('vi-VN')} đ`; return `<div style=\"font-size:0.76rem;color:var(--secondary-text-color);font-weight:700;letter-spacing:0.08em;text-transform:uppercase;\">House</div><div style=\"font-size:0.95rem;color:var(--primary-text-color);font-weight:800;margin-top:4px;\">${load} kWh</div><div style=\"font-size:0.85rem;color:var(--secondary-text-color);margin-top:8px;\">Equivalent bill</div><div style=\"font-size:0.95rem;color:var(--primary-text-color);font-weight:800;\">${costStr}</div>`; ]]]",
                "mode": "[[[ const status = states['sensor.lumentree_local_p240819130_battery_status']?.state || 'Idle'; return status; ]]]"
