                "header": "[[[ return `\n      <div style=\"display:flex;align-items:flex-end;justify-content:space-between;gap:12px;\">\n        <div>\n          <div style=\"font-size:0.82rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--secondary-text-color);\">Forecast</div>\n          <div style=\"font-size:1.35rem;font-weight:800;color:var(--primary-text-color);margin-top:4px;\">Solar production</div>\n        </div>\n        <div style=\"padding:6px 10px;border-radius:999px;background:rgba(var(--rgb-primary-color),0.10);color:var(--primary-color);font-size:0.78rem;font-weight:700;\">Solcast + Live</div>\n      </div>`; ]]]",
