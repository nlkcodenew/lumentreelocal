              "custom_fields": {
                "soc": "[[[\n  const soc = parseFloat(states['sensor.lumentree_local_p240819130_battery_soc'].state) || 0;\n  return `${soc.toFixed(0)}%`;\n]]]\n",
                "power": "[[[\n  const adjustedPower = parseFloat(states['sensor.battery_power_adjusted'].state) || 0;\n  // LOGIC: Dương = Xả, Âm = Sạc, ~0 = Nghỉ\n  const prefix = adjustedPower > 0 ? 'Xả: ' : adjustedPower < 0 ? 'Sạc: ' : 'Nghỉ: ';\n  return `${prefix}${Math.abs(adjustedPower).toFixed(0)} W`;\n]]]\n",
                "top_left": "[[[\n  const soc = parseFloat(states['sensor.lumentree_local_p240819130_battery_soc'].state) || 0;\n  const remaining = (14 * soc / 100).toFixed(1);\n  \n  const adjustedPower = parseFloat(states['sensor.battery_power_adjusted'].state) || 0;\n  const chargePowerAbs = Math.abs(adjustedPower);\n  let timeLabel = 'Thời gian:';\n  let timeStr = '—';\n\n  if (chargePowerAbs >= 10) {\n    let hoursTotal = 0;\n    \n    if (adjustedPower > 0) { \n       // Dương: ĐANG XẢ -> Tính thời gian CẠN (Empty)\n       timeLabel = 'Cạn sau:';\n       hoursTotal = (14 * (soc / 100)) / (chargePowerAbs / 1000);\n    } else { \n       // Âm: ĐANG SẠC -> Tính thời gian ĐẦY (Full)\n       timeLabel = 'Đầy sau:';\n       hoursTotal = (14 * (1 - soc / 100)) / (chargePowerAbs / 1000);\n    }\n\n    if (isFinite(hoursTotal)) {\n      const h = Math.floor(hoursTotal);\n      const m = Math.round((hoursTotal - h) * 60);\n      timeStr = `${h}h ${m}m`;\n    }\n  }\n\n  const labelStyle = 'color: var(--text-secondary-color); font-size: 0.8rem;';\n  const valStyle = 'color: white; font-weight: bold; font-size: 0.9rem;';\n\n  return `\n    <div><span style=\"${labelStyle}\">Tổng pin:</span> <span style=\"${valStyle}\">14 số</span></div>\n    <div><span style=\"${labelStyle}\">Còn lại:</span> <span style=\"${valStyle}\">${remaining} số</span></div>\n    <div style=\"margin-top: 4px;\"><span style=\"${labelStyle}\">${timeLabel}</span> <br><span style=\"${valStyle}; font-size: 1rem; color: var(--primary-color)\">${timeStr}</span></div>\n  `;\n]]]\n",
                "top_right": "[[[\n  const charge = parseFloat(states['sensor.lumentree_local_p240819130_daily_battery_charge_energy'].state) || 0;\n  const discharge = parseFloat(states['sensor.lumentree_local_p240819130_daily_battery_discharge_energy'].state) || 0;\n  \n  const labelStyle = 'color: var(--text-secondary-color); font-size: 0.8rem;';\n  const chargeValStyle = 'color: #00ff7f; font-weight: bold; font-size: 0.9rem;';\n  const dischargeValStyle = 'color: #ff6347; font-weight: bold; font-size: 0.9rem;';\n\n  return `\n    <div><span style=\"${labelStyle}\">Sạc hôm nay:</span> <span style=\"${chargeValStyle}\">${charge.toFixed(1)} số</span></div>\n    <div><span style=\"${labelStyle}\">Xả hôm nay:</span> <span style=\"${dischargeValStyle}\">${discharge.toFixed(1)} số</span></div>\n  `;\n]]]\n",
                "bottom_right": "[[[\n  const load = states['sensor.tai_tong_nha'].state;\n  const cost = parseFloat(states['sensor.tien_phai_tra_neu_khong_co_nlmt'].state);\n  const costStr = isNaN(cost) ? 'N/A' : `${cost.toLocaleString('vi-VN')} đ`;\n\n  const labelStyle = 'color: var(--text-secondary-color); font-size: 0.8rem;';\n  const valStyle = 'color: white; font-weight: bold; font-size: 0.9rem;';\n\n  return `\n    <div><span style=\"${labelStyle}\">Số điện:</span><br><span style=\"${valStyle}\">${load} số</span></div>\n    <div style=\"margin-top: 4px;\"><span style=\"${labelStyle}\">Tiền thực:</span><br><span style=\"${valStyle}\">${costStr}</span></div>\n  `;\n]]]\n"
              }
            }
          ]
