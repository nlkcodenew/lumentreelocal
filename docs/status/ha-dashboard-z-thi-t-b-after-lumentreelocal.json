              "custom_fields": {
                "header": "[[[\n  return `<div style=\"\n    display: flex; align-items: center; justify-content: center;\n    margin-bottom: 20px;\n  \">\n    <span style=\"\n      font-size: 1.2rem; font-weight: 900; text-transform: uppercase; letter-spacing: 2px;\n      background: -webkit-linear-gradient(45deg, #FFD700, #FF8C00);\n      -webkit-background-clip: text; -webkit-text-fill-color: transparent;\n    \">Năng lượng mặt trời</span>\n  </div>`;\n]]]\n",
                "row_forecast_today": "[[[\n  const state = states['sensor.solcast_pv_forecast_forecast_today'].state;\n  const unit = states['sensor.solcast_pv_forecast_forecast_today'].attributes.unit_of_measurement || 'kWh';\n  return `\n  <div style=\"\n    display: flex; align-items: center; justify-content: space-between;\n    background: rgba(255, 215, 0, 0.05); border: 1px solid rgba(255, 215, 0, 0.2);\n    border-radius: 12px; padding: 12px; margin-bottom: 12px;\n  \">\n    <div style=\"display: flex; align-items: center; gap: 12px;\">\n      <ha-icon icon=\"mdi:weather-sunny\" style=\"color: #FFD700; width: 24px; height: 24px; filter: drop-shadow(0 0 5px rgba(255,215,0,0.6));\"></ha-icon>\n      <span style=\"color: #ddd; font-weight: 500; font-size: 0.95rem;\">Dự báo hôm nay</span>\n    </div>\n    <span style=\"\n      font-weight: bold; font-size: 1.1rem;\n      background: -webkit-linear-gradient(0deg, #FFD700, #FFA500);\n      -webkit-background-clip: text; -webkit-text-fill-color: transparent;\n    \">${state} <span style=\"font-size: 0.8rem; opacity: 0.7; color: #FFD700; -webkit-text-fill-color: #FFD700;\">${unit}</span></span>\n  </div>`;\n]]]\n",
                "row_production": "[[[\n  const state = states['sensor.lumentree_local_p240819130_daily_pv_energy'].state;\n  const unit = states['sensor.lumentree_local_p240819130_daily_pv_energy'].attributes.unit_of_measurement || 'kWh';\n  return `\n  <style>\n    @keyframes pulse-sun {\n      0% { transform: scale(1); filter: drop-shadow(0 0 2px rgba(255, 69, 0, 0.5)); }\n      50% { transform: scale(1.2); filter: drop-shadow(0 0 10px rgba(255, 69, 0, 1)); }\n      100% { transform: scale(1); filter: drop-shadow(0 0 2px rgba(255, 69, 0, 0.5)); }\n    }\n  </style>\n  <div style=\"\n    display: flex; align-items: center; justify-content: space-between;\n    background: rgba(255, 69, 0, 0.1); border: 1px solid rgba(255, 69, 0, 0.4);\n    box-shadow: 0 0 10px rgba(255, 69, 0, 0.15); border-radius: 12px;\n    padding: 14px; margin-bottom: 12px;\n  \">\n    <div style=\"display: flex; align-items: center; gap: 12px;\">\n      <div style=\"animation: pulse-sun 3s infinite ease-in-out;\">\n        <ha-icon icon=\"mdi:solar-power-variant\" style=\"color: #ff4500; width: 28px; height: 28px;\"></ha-icon>\n      </div>\n      <span style=\"color: white; font-weight: 700; font-size: 1rem; text-transform: uppercase;\">Sản lượng thực tế</span>\n    </div>\n    <span style=\"\n      font-weight: 900; font-size: 1.3rem;\n      background: -webkit-linear-gradient(0deg, #ff4500, #ffae00);\n      -webkit-background-clip: text; -webkit-text-fill-color: transparent;\n      text-shadow: 0 0 15px rgba(255, 69, 0, 0.3);\n    \">${state} <span style=\"font-size: 0.8rem; opacity: 0.7; color: #ff4500; -webkit-text-fill-color: #ff4500;\">${unit}</span></span>\n  </div>`;\n]]]\n",
                "row_forecast_tomorrow": "[[[\n  const state = states['sensor.solcast_pv_forecast_forecast_tomorrow'].state;\n  const unit = states['sensor.solcast_pv_forecast_forecast_tomorrow'].attributes.unit_of_measurement || 'kWh';\n  return `\n  <div style=\"\n    display: flex; align-items: center; justify-content: space-between;\n    background: rgba(0, 191, 255, 0.05); border: 1px solid rgba(0, 191, 255, 0.2);\n    border-radius: 12px; padding: 12px;\n  \">\n    <div style=\"display: flex; align-items: center; gap: 12px;\">\n      <ha-icon icon=\"mdi:weather-partly-cloudy\" style=\"color: #00bfff; width: 24px; height: 24px; filter: drop-shadow(0 0 5px rgba(0,191,255,0.6));\"></ha-icon>\n      <span style=\"color: #ddd; font-weight: 500; font-size: 0.95rem;\">Dự báo ngày mai</span>\n    </div>\n    <span style=\"\n      font-weight: bold; font-size: 1.1rem;\n      background: -webkit-linear-gradient(0deg, #00bfff, #1e90ff);\n      -webkit-background-clip: text; -webkit-text-fill-color: transparent;\n    \">${state} <span style=\"font-size: 0.8rem; opacity: 0.7; color: #00bfff; -webkit-text-fill-color: #00bfff;\">${unit}</span></span>\n  </div>`;\n]]]\n"
              }
