        "title": "Lumentree Local",
        "description": "Update the inverter Device ID. The read grant stays required for normal data access. Warning: any write-capable entity in this integration changes inverter settings directly on the inverter. Keep the integration read-only unless you intend to modify inverter behavior. To enable production write access, open the ESP32 portal, generate a one-time write pairing token, and enter it here. Tokens are shown in uppercase for clarity, but they are not case-sensitive.",
        "data": {
          "device_id": "Device ID",
          "write_pairing_code": "Write pairing token for direct inverter changes",
          "revoke_write_access": "Revoke current write access",
          "keep_write_grant": "Keep current write access enabled"
        }
      }
    },
